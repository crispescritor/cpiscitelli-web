# ── Seguridad básica ─────────────────────────────────────────────
Options -Indexes
DirectoryIndex index.html index.php

# ── Rewrite: servir index.html en rutas limpias ──────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html -f
  RewriteRule ^(.*)$ $1index.html [L]
</IfModule>

# ── Cache-Control por tipo de archivo ────────────────────────────
<IfModule mod_headers.c>

  # HTML: NUNCA cachear — el visitante siempre recibe la versión más fresca
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
    # LiteSpeed (Hostinger): tampoco cachear en servidor
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>

  # CSS y JS: 1 año (Hugo genera nombres únicos con hash al cambiar)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes: 6 meses (pueden actualizarse)
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>

  # Fuentes: 1 año (no cambian)
  <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Audio y video: 1 semana
  <FilesMatch "\.(mp3|mp4|webm|ogg|m4a|wav|flac|mov|avi)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # XML (sitemap, feeds): no cachear
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Expires "0"
  </FilesMatch>

  # Headers de seguridad
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

</IfModule>

# ── Expires (respaldo si mod_headers no está disponible) ─────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType image/png                     "access plus 6 months"
  ExpiresByType image/jpeg                    "access plus 6 months"
  ExpiresByType image/gif                     "access plus 6 months"
  ExpiresByType image/webp                    "access plus 6 months"
  ExpiresByType image/svg+xml                 "access plus 6 months"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType audio/mpeg                    "access plus 1 week"
  ExpiresByType video/mp4                     "access plus 1 week"
  ExpiresByType application/xml               "access plus 0 seconds"
  ExpiresByType text/xml                      "access plus 0 seconds"
</IfModule>

# ── Compresión GZIP/Deflate ───────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# ── Tipos MIME correctos ──────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript          .js
  AddType text/css                        .css
  AddType font/woff2                      .woff2
  AddType font/woff                       .woff
  AddType image/webp                      .webp
  AddType image/avif                      .avif
  AddType audio/mpeg                      .mp3
  AddType video/mp4                       .mp4
</IfModule>
